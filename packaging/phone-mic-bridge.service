[Unit]
Description=phone-mic bridge (phone microphone into Phone-Mic)
Documentation=file:@PHONE_MIC_PREFIX@/README.md
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service
# The phone is not always reachable: retrying forever is the intended behaviour,
# so the start rate limit must not give up on it.
StartLimitIntervalSec=0

[Service]
Type=simple
# The remap source (phone_mic) cannot be declared in pipewire.conf.d: the module
# that implements it is not shipped by pipewire 1.6, and a mandatory module that
# fails aborts the whole daemon. It is created here through pactl instead, where
# pipewire-pulse implements it in-process. The script is idempotent, so this costs
# nothing when the nodes already exist, and it makes a fresh boot work without a
# manual step: the null sink comes from the configuration, the source comes here.
# Failing this step is deliberate: running the bridge without the source would
# forward audio into a sink nobody can capture from, and a silent microphone is
# worse than a visible restart loop.
# @PHONE_MIC_PREFIX@ is substituted by packaging/install.sh with the install
# prefix, where the copied scripts live; the checkout is not needed once
# installed. Never hardcode a path here: a wrong one fails ExecStartPre before
# the bridge starts, and a bridge that cannot start never creates phone_mic, so
# the microphone disappears with no audio error to point at.
# Quoted on purpose: install.sh substitutes an absolute path, and systemd splits
# an unquoted Exec line on whitespace, so a prefix under a directory with a space
# would fail before the bridge starts.
ExecStartPre="@PHONE_MIC_PREFIX@/scripts/load-virtual-mic.sh"
# connect first, then forward: every restart reconnects adb (last known port,
# then mDNS discovery) before resuming audio. Chained here so the bridge needs no
# desktop launcher.
ExecStart=/bin/sh -c '@PHONE_MIC_PREFIX@/scripts/connect-phone.sh && exec @PHONE_MIC_PREFIX@/scripts/scrcpy-mic.sh' 
# A dropped adb link, a phone that went to sleep or a scrcpy crash all end this
# process; restarting runs scripts/connect-phone.sh again, which retries the last
# known port and then discovers the advertised service over mDNS.
Restart=always
RestartSec=5
# Real-time audio path.
Nice=-5

[Install]
WantedBy=default.target
