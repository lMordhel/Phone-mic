---
import '../styles/base.css';
import { DEFAULT_THEME, themeNames, themeStylesheet } from '../data/themes.ts';
import { copy, LANGS, type Lang } from '../i18n/copy.ts';
import { withBase } from '../lib/paths.ts';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = copy[lang];

// English lives at the root, every other language in its own folder.
const routeFor = (code: Lang): string => (code === 'en' ? '/' : `/${code}/`);

// An hreflang link has to be an absolute URL, so it is only emitted when the
// deploy domain is known (`site` in astro.config.mjs). Without it the page ships
// no alternate links at all instead of links pointing at the wrong host.
const site = Astro.site;
const alternates = site
  ? [
      ...LANGS.map((code) => ({
        hreflang: code as string,
        href: new URL(withBase(routeFor(code)), site).href,
      })),
      { hreflang: 'x-default', href: new URL(withBase(routeFor('en')), site).href },
    ]
  : [];

// Runs before first paint: a palette saved in the theme picker must not flash
// the default one. `is:inline` keeps it out of the module bundle.
const bootTheme = `(function(){try{var s=localStorage.getItem('phone-mic-theme');var ok=${JSON.stringify(
  themeNames,
)};if(s&&ok.indexOf(s)>-1){document.documentElement.dataset.theme=s;}}catch(e){}})();`;
---

<!doctype html>
<html lang={lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%231e140a'/%3E%3Crect x='7' y='11' width='18' height='3' fill='%23f5b446'/%3E%3Crect x='7' y='17' width='11' height='3' fill='%23f5b446'/%3E%3C/svg%3E"
    />
    <style is:inline set:html={themeStylesheet}></style>
    <script is:inline set:html={bootTheme}></script>
  </head>
  <body>
    <a class="skip" href="#main">{t.a11y.skip}</a>
    <div class="stars" aria-hidden="true"></div>
    <div class="frame">
      <slot />
    </div>
    <script>
      import '../scripts/client.ts';
    </script>
  </body>
</html>
